[Install]
WantedBy=default.target

[Service]
Environment=AI_SANDBOX_RELAX=
Environment=PATH=@SERVICE_PATH@
Environment=TMPDIR=%t/agent-web/opencode-web
ExecStart=@AI_SANDBOX_RUN@/bin/ai-sandbox-run -- @NONO@/bin/nono run --profile opencode-web --workdir @HOME@/projects --strict-broker-path --silent -- opencode serve --port 15435 --hostname 127.0.0.1
Restart=always
RestartSec=5
RuntimeDirectory=agent-web/opencode-web
RuntimeDirectoryMode=0700
Type=simple
WorkingDirectory=@HOME@/projects

[Unit]
Description=opencode web UI server
Wants=opencode-web-proxy.service
X-Restart-Triggers=opencode-web.json:1a783902803fa62d59334356e03fcadc9fe8ed20e773333165867e42072d378f
X-Restart-Triggers=ai-sandbox-opencode.json:e2916663fef57f9bed490459dafa50e5674fb67fa5da0ae9e762e7a693ebafd0
