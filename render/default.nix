# The render fixtures and the render derivation.
#
# The files a user without Nix installs (`profiles/`, `shell/aliases.d/`, ...) are the
# output of this repository's own module evaluated for fixed configurations; only
# `nix run .#render` writes them into the checkout and the `render-*` checks compare them
# with `tree`. The fixtures use stub packages and sentinel paths, so the output holds
# placeholders (`@HOME@`, `@NONO@`, ...) instead of store paths and home directories.
{
  pkgs,
  lib,
  self,
  home-manager,
}: let
  stub = name: pkgs.writeShellScriptBin name "exit 0";
  nono = stub "nono";
  caddy = stub "caddy";

  # F_S: every default, the opencode-web service on. The sentinel directories carry a
  # leading slash (they are absolute paths for the module); the render drops it.
  base = {
    home = {
      username = "ai-sandbox";
      homeDirectory = "/@HOME@";
      stateVersion = "25.11";
    };
    xdg.configHome = "/@XDG_CONFIG_HOME@";
    xdg.cacheHome = "/@XDG_CACHE_HOME@";
    programs.aiSandbox = {
      enable = true;
      package = nono;
      services.opencode-web = {
        enable = true;
        path = ["@SERVICE_PATH@"];
        proxy.package = caddy;
      };
    };
  };

  eval = extra:
    (home-manager.lib.homeManagerConfiguration {
      inherit pkgs;
      modules = [self.homeModules.default base extra];
    })
    .config;

  # F_S0: the isolation off (the alias set of an install with `ISOLATION=0`).
  # F_Sv: F_S plus a project-directory variant (the shape the README documents).
  fs = eval {};
  fs0 = eval {programs.aiSandbox.isolation.enable = false;};
  fsv = eval {
    programs.aiSandbox.variants.pi_notes = {
      harness = "pi";
      suffix = "notes";
      allow = ["$HOME/src/notes"];
    };
  };

  a = fs.programs.aiSandbox;

  # Store paths and sentinels to placeholders. A package placeholder is the prefix that holds
  # `bin/<tool>`; the installer resolves it.
  substFrom = ["${a.runPackage}" "${nono}" "${caddy}" "/@HOME@" "/@XDG_CONFIG_HOME@" "/@XDG_CACHE_HOME@"];
  substTo = ["@AI_SANDBOX_RUN@" "@NONO@" "@CADDY@" "@HOME@" "@XDG_CONFIG_HOME@" "@XDG_CACHE_HOME@"];
  subst = lib.replaceStrings substFrom substTo;

  profilePrefix = "nono/profiles/";
  profiles =
    lib.mapAttrs' (n: f: lib.nameValuePair (lib.removeSuffix ".json" (lib.removePrefix profilePrefix n)) f)
    (lib.filterAttrs (n: f: f.enable && lib.hasPrefix profilePrefix n) fs.xdg.configFile);

  # Aliases: one file per (command, variant suffix), `<command>.sh` and `<command>-<suffix>.sh`,
  # holding the alias and its `_nono` twin; `00-session.sh` holds the session variables the
  # module adds. Not substituted: the aliases name `nono` and `ai-sandbox-run` bare, so a
  # store path in one is a bug the hygiene check below reports.
  header = "# Generated by `nix run .#render` from the Nix module; edit the module, not this file.\n";

  variantGroup = e: "${e.command}-${e.spec.suffix}";

  aliasGroups = c: let
    p = c.programs.aiSandbox;
    twins = n: [n "${n}_nono"];
    owners =
      lib.concatMap (h: map (k: lib.nameValuePair k h) (twins h)) (lib.attrNames p.harnessProfiles)
      ++ lib.concatLists (lib.mapAttrsToList
        (alias: e: map (k: lib.nameValuePair k (variantGroup e)) (twins alias))
        p.internal.variants);
    ownerOf = lib.listToAttrs owners;
  in
    lib.groupBy (k: ownerOf.${k} or (throw "render: the alias ${k} belongs to no harness or variant"))
    (lib.attrNames c.home.shellAliases);

  # What the module adds to the session: F_S's variables minus those of the same home without it
  # (Home Manager sets a few of its own, e.g. the locale archive).
  bare =
    (home-manager.lib.homeManagerConfiguration {
      inherit pkgs;
      modules = [{inherit (base) home xdg;}];
    })
    .config;
  sessionVars = c: lib.filterAttrs (n: v: (bare.home.sessionVariables.${n} or null) != v) c.home.sessionVariables;

  aliasFiles = c:
    lib.mapAttrs' (g: ks:
      lib.nameValuePair "${g}.sh" (header
        + lib.concatMapStrings (k: "alias -- ${k}=${lib.escapeShellArg c.home.shellAliases.${k}}\n") ks))
    (aliasGroups c)
    // {
      "00-session.sh" =
        header
        + lib.concatMapStrings (n: "export ${n}=${lib.escapeShellArg (sessionVars c).${n}}\n") (lib.attrNames (sessionVars c));
    };

  installFiles = dir: files:
    lib.concatStringsSep "\n" (lib.mapAttrsToList (n: t: ''
        install -D -m 0644 ${pkgs.writeText n t} "$out/${dir}/${n}"
      '')
      files);

  # The kernel settings of the NixOS module, evaluated against a stub of the one option it sets.
  nixosConfig =
    (lib.evalModules {
      modules = [
        self.nixosModules.default
        {options.boot.kernel.sysctl = lib.mkOption {type = lib.types.attrsOf lib.types.anything;};}
        {programs.aiSandbox.enable = true;}
      ];
    })
    .config;
  sysctlText =
    header
    + lib.concatStrings (lib.mapAttrsToList (k: v: "${k} = ${toString v}\n") nixosConfig.boot.kernel.sysctl);

  # Services: the unit files Home Manager builds (a build input read inside the derivation: no
  # import from a derivation), with store paths and sentinels replaced by the same
  # placeholders; the Caddyfile is the module's `.text`. A service with a proxy must list its
  # `<service>-proxy` unit. `services/` holds F_S's units (run through the wrapper),
  # `services-nono/` F_S0's (an install with `ISOLATION=0`: no wrapper, no relax override).
  sedArgs = lib.escapeShellArgs (lib.concatLists (lib.zipListsWith (f: t: ["-e" "s|${f}|${t}|g"]) substFrom substTo));
  serviceFiles = c: dir:
    assert lib.assertMsg (c.programs.aiSandbox.serviceUnits == a.serviceUnits)
    "render: the fixtures run different units: ${builtins.toJSON c.programs.aiSandbox.serviceUnits}, want ${builtins.toJSON a.serviceUnits}";
      lib.concatStringsSep "\n" (lib.mapAttrsToList (s: units:
        assert lib.assertMsg (!a.services.${s}.proxy.enable || lib.elem "${s}-proxy" units)
        "render: the service ${s} has a proxy but serviceUnits lists no ${s}-proxy unit"; ''
          mkdir -p "$out/${dir}/${s}"
          ${lib.concatMapStringsSep "\n" (u: ''
              sed ${sedArgs} ${c.xdg.configFile."systemd/user/${u}.service".source} >"$out/${dir}/${s}/${u}.service"
            '')
            units}
          ${lib.optionalString a.services.${s}.proxy.enable ''
            install -m 0644 ${pkgs.writeText "Caddyfile" (subst c.xdg.configFile."agent-web/${s}/Caddyfile".text)} "$out/${dir}/${s}/Caddyfile"
          ''}
        '')
      a.serviceUnits);

  # The service files of F_S with the proxy on other listen addresses (`<label>/<service>/...`,
  # placeholders as in services/): what the installer's PROXY_LISTEN must give (checks/install-sh).
  listenAddresses = {
    every = "0.0.0.0";
    doc = "192.0.2.10";
    v6lo = "::1";
  };
  listenTree = pkgs.runCommand "ai-sandbox-render-listen" {} (lib.concatStrings (lib.mapAttrsToList (label: addr:
    serviceFiles (eval {programs.aiSandbox.services.opencode-web.proxy.listenAddress = addr;}) label)
  listenAddresses));

  # The profile a service's units run: the `--profile` argument of their ExecStart lines (a
  # proxy unit has none). Exactly one, and one that profiles/ holds.
  serviceProfile = s: units: let
    # (the context of the store paths in the line dropped: a name, not a path)
    words = u: lib.splitString " " (builtins.unsafeDiscardStringContext (lib.concatStringsSep " " (lib.toList fs.systemd.user.services.${u}.Service.ExecStart)));
    profileArgs = ws: lib.concatLists (lib.imap1 (i: w: lib.optional (w == "--profile") (lib.elemAt ws i)) ws);
    found = lib.unique (lib.concatMap (u: profileArgs (words u)) units);
  in
    assert lib.assertMsg (lib.length found == 1 && profiles ? ${lib.head found})
    "render: the units of the service ${s} run the profiles ${builtins.toJSON found}; want exactly one of profiles/ (${toString (lib.attrNames profiles)})";
      lib.head found;

  # What the installer reads (install/): harness -> profile, alias file and variants (`gpu` marks
  # the ones `GPU=0` leaves out); service -> profile, units, whether it has a Caddyfile, data
  # dirs, working tree and the commands its units run (the installer looks them up on the
  # units' PATH); the ai-sandbox bases, each with the registry pack it is made from (the
  # installer installs a base with the profiles extending it and pulls its pack); the
  # directories activation creates (one per line, placeholders for the sentinels).
  installJson = {
    "bases.json" = a.internal.baseProfiles;
    "harnesses.json" =
      lib.mapAttrs (h: profile: {
        inherit profile;
        aliases = "${h}.sh";
        variants =
          lib.mapAttrs (_: e: {
            inherit (e) profile;
            aliases = "${variantGroup e}.sh";
            gpu = e.spec.allowGpu;
          })
          (lib.filterAttrs (_: e: e.command == h) a.internal.variants);
      })
      a.harnessProfiles;
    "services.json" =
      lib.mapAttrs (s: units: {
        profile = serviceProfile s units;
        inherit units;
        caddyfile = a.services.${s}.proxy.enable;
        dataDirs = map subst a.services.${s}.dataDirs;
        workdir = subst a.services.${s}.workdir;
        commands = lib.unique (lib.mapAttrsToList (_: u: lib.head u.exec) a.services.${s}.units);
      })
      a.serviceUnits;
  };
  installDirs = lib.concatMapStrings (d: subst d + "\n") a.internal.activationDirs;

  tree =
    pkgs.runCommand "ai-sandbox-render" {nativeBuildInputs = [pkgs.jq pkgs.gnugrep];}
    ''
      mkdir -p "$out/profiles"
      ${lib.concatStringsSep "\n" (lib.mapAttrsToList (n: f: ''
          jq -S . ${pkgs.writeText "${n}.json" (subst f.text)} >"$out/profiles/${n}.json"
        '')
        profiles)}
      echo ${lib.escapeShellArg pkgs.nono.version} >"$out/profiles/NONO_VERSION"
      ${installFiles "shell/aliases.d" (aliasFiles fs)}
      ${installFiles "shell/aliases-nono.d" (aliasFiles fs0)}
      ${installFiles "sysctl" {"60-ai-sandbox.conf" = sysctlText;}}
      ${serviceFiles fs "services"}
      ${serviceFiles fs0 "services-nono"}
      mkdir -p "$out/install"
      ${lib.concatStringsSep "\n" (lib.mapAttrsToList (n: v: ''
          jq -S . ${pkgs.writeText n (builtins.toJSON v)} >"$out/install/${n}"
        '')
        installJson)}
      install -m 0644 ${pkgs.writeText "dirs" installDirs} "$out/install/dirs"

      # Hygiene: no store path in an artifact, no placeholder but the known ones.
      ! grep -rlF /nix/store "$out" || { echo "render: store path in an artifact" >&2; exit 1; }
      bad=$(grep -rhoE '@[A-Z_]+@' "$out" | sort -u | grep -vxE '@(HOME|XDG_CONFIG_HOME|XDG_CACHE_HOME|SERVICE_PATH|AI_SANDBOX_RUN|NONO|CADDY)@' || true)
      [ -z "$bad" ] || { echo "render: unknown placeholders: $bad" >&2; exit 1; }
    '';

  # `nix run .#render`, from the repository root: the only writer of the generated directories.
  app = pkgs.writeShellApplication {
    name = "ai-sandbox-render";
    runtimeInputs = [pkgs.coreutils];
    text = ''
      [ -f flake.nix ] && [ -f packages/ai-sandbox-run/sandbox-run.sh ] || { echo "run from the repository root" >&2; exit 2; }
      for d in profiles shell/aliases.d shell/aliases-nono.d services services-nono sysctl install; do rm -rf "$d"; done
      cp -r --no-preserve=mode ${tree}/. .
    '';
  };
in {inherit tree app fs fs0 fsv listenAddresses listenTree;}
