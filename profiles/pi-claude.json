{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "environment": {
    "deny_vars": [
      "WAYLAND_DISPLAY",
      "DISPLAY"
    ],
    "set_vars": {
      "JITI_FS_CACHE": "$XDG_CACHE_HOME/pi/jiti",
      "NODE_COMPILE_CACHE": "$XDG_CACHE_HOME/pi/node-compile-cache"
    }
  },
  "extends": [
    "nolabs-ai/pi"
  ],
  "filesystem": {
    "allow": [
      "$TMPDIR",
      "$XDG_CACHE_HOME/pi"
    ],
    "allow_file": [],
    "deny": []
  },
  "groups": {
    "exclude": [
      "user_caches_linux"
    ]
  },
  "meta": {
    "name": "pi-claude"
  }
}
